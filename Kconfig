# robohub-esp32 Kconfig
# Platform-level configuration for ESP32 boards.

menu "RoboHub ESP32 Platform"

config RH_HAL_GPIO
    bool "GPIO HAL"
    default y
    help
      Enable GPIO peripheral HAL implementation.

config RH_HAL_I2C
    bool "I2C HAL"
    default y
    help
      Enable I2C peripheral HAL implementation.

config RH_HAL_SPI
    bool "SPI HAL"
    default y
    help
      Enable SPI peripheral HAL implementation.

config RH_HAL_UART
    bool "UART HAL"
    default y
    help
      Enable UART peripheral HAL implementation.

config RH_HAL_TIMER
    bool "Timer HAL"
    default y
    help
      Enable Timer HAL implementation.

config RH_HAL_RS485
    bool "RS485 HAL"
    default n
    help
      Enable RS485 HAL implementation.

endmenu
