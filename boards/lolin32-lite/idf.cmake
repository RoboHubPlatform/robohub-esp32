# What makes this board's build ESP-IDF's build.
#
# Included from the generated toolchain.cmake, before `project()`, which is
# where the framework has to be located and its toolchain file chosen. From
# there ESP-IDF owns everything an ESP32 image needs: the second-stage
# bootloader, the partition table, the linker fragments for each memory, and
# the app image build.
#
# The IDF is vendored beside this platform, through the vendor config the
# board declares, so the version a board was built against is the version it
# builds with.
#
# @project RoboHub Platform
# @license MIT

get_filename_component(IDF_PATH "${CMAKE_CURRENT_LIST_DIR}/../../vendor/esp-idf" ABSOLUTE)
set(IDF_PATH "${IDF_PATH}" CACHE PATH "the ESP-IDF this platform vendors")
set(ENV{IDF_PATH} "${IDF_PATH}")

# The tools ESP-IDF installed live under one prefix, and its own Python
# environment is where its build scripts and the component manager live. The
# build is run through that interpreter rather than the system one, which has
# neither; the environment is found rather than named, so a machine whose IDF
# version differs still builds.
set(ENV{IDF_TOOLS_PATH} "$ENV{HOME}/.espressif")
file(GLOB ROBOHUB_IDF_PYTHON_ENVS "$ENV{HOME}/.espressif/python_env/idf*_py*_env")
if(ROBOHUB_IDF_PYTHON_ENVS)
    list(GET ROBOHUB_IDF_PYTHON_ENVS 0 ROBOHUB_IDF_PYTHON_ENV)
    set(ENV{IDF_PYTHON_ENV_PATH} "${ROBOHUB_IDF_PYTHON_ENV}")
    set(ENV{PYTHON} "${ROBOHUB_IDF_PYTHON_ENV}/bin/python")
    message(STATUS "[robohub-esp32] ESP-IDF python env at ${ROBOHUB_IDF_PYTHON_ENV}")
else()
    message(WARNING "[robohub-esp32] no ESP-IDF python environment found under ~/.espressif; run the vendored IDF's install.sh esp32")
endif()

# ESP-IDF builds Xtensa code from C, C++ and assembly, so the generated build
# is told to enable all three once the compiler below is known.
set(RHO_PROGRAM_LANGUAGES "C;CXX;ASM")

# The part this board carries. ESP-IDF is one framework for a family of chips,
# and which one is being built for is named rather than derived.
set(IDF_TARGET "esp32" CACHE STRING "the chip this board carries")
set(ENV{IDF_TARGET} "esp32")

# The chip's toolchain file, which must be chosen before `project()`: this is
# where the compiler, its flags and the per-memory linker fragments come from.
# `IDF_TOOLCHAIN` is the kind — gcc — and not this file, which is what ESP-IDF
# compares against what the build was configured with.
set(IDF_TOOLCHAIN "gcc" CACHE STRING "the toolchain kind ESP-IDF builds with")
set(CMAKE_TOOLCHAIN_FILE "${IDF_PATH}/tools/cmake/toolchain-esp32.cmake" CACHE FILEPATH "the ESP32 toolchain")

# The production preset, only when the project asked for it (CONFIG_RH_PRODUCTION
# in its configuration; off by default). It must be decided here, before ESP-IDF
# writes sdkconfig, so the resolved configuration rho build wrote beside the
# generated project is read now rather than after `project()`.
#
# Nothing is burned by building: secure boot v2, flash encryption (release) and
# NVS encryption are burned into eFuses by the image's bootloader at its first
# boot, and `rho flash --production` lists those steps and asks for the board's
# name before writing the image. See production/esp32.json and docs/index.md.
#
# The resolved configuration is `<build>/config-check/.config`, two levels above
# the generated project; a value passed with -DRHO_CONFIG_RH_PRODUCTION wins.
if(NOT DEFINED RHO_CONFIG_RH_PRODUCTION)
    set(RHO_CONFIG_RH_PRODUCTION OFF)
    get_filename_component(ROBOHUB_ESP_RESOLVED_CONFIG "${CMAKE_SOURCE_DIR}/../../config-check/.config" ABSOLUTE)
    if(EXISTS "${ROBOHUB_ESP_RESOLVED_CONFIG}")
        file(STRINGS "${ROBOHUB_ESP_RESOLVED_CONFIG}" ROBOHUB_ESP_PRODUCTION_LINE REGEX "^CONFIG_RH_PRODUCTION=y$")
        if(ROBOHUB_ESP_PRODUCTION_LINE)
            set(RHO_CONFIG_RH_PRODUCTION ON)
        endif()
    endif()
endif()
if(RHO_CONFIG_RH_PRODUCTION)
    get_filename_component(ROBOHUB_ESP_PRODUCTION_DIR "${CMAKE_CURRENT_LIST_DIR}/../../production" ABSOLUTE)
    if(NOT DEFINED ENV{RH_SECURE_BOOT_SIGNING_KEY} OR NOT EXISTS "$ENV{RH_SECURE_BOOT_SIGNING_KEY}")
        message(FATAL_ERROR
            "[robohub-esp32] CONFIG_RH_PRODUCTION is set, so the image is signed for secure boot v2: "
            "set RH_SECURE_BOOT_SIGNING_KEY to the RSA-3072 PEM signing key "
            "(espsecure.py generate_signing_key --version 2 --scheme rsa3072 <file>). "
            "Keep that key: a board that booted a production image accepts nothing it did not sign.")
    endif()
    file(TO_CMAKE_PATH "$ENV{RH_SECURE_BOOT_SIGNING_KEY}" ROBOHUB_ESP_SIGNING_KEY)
    get_filename_component(ROBOHUB_ESP_SIGNING_KEY "${ROBOHUB_ESP_SIGNING_KEY}" ABSOLUTE)
    set(ROBOHUB_ESP_PRODUCTION_LOCAL "${CMAKE_BINARY_DIR}/sdkconfig.rh-production-local")
    file(WRITE "${ROBOHUB_ESP_PRODUCTION_LOCAL}"
        "# Generated by robohub-esp32 idf.cmake for a production build. DO NOT EDIT.\n"
        "CONFIG_SECURE_BOOT_SIGNING_KEY=\"${ROBOHUB_ESP_SIGNING_KEY}\"\n"
        "CONFIG_PARTITION_TABLE_CUSTOM_FILENAME=\"${ROBOHUB_ESP_PRODUCTION_DIR}/partitions.production.csv\"\n")
    # A sdkconfig of its own, so switching a tree to production cannot keep the
    # plain configuration ESP-IDF already wrote (defaults never override an
    # existing sdkconfig), and switching back returns to the plain one. It is
    # rewritten from the preset at every configure, so what is built is exactly
    # the preset and the key named now, never a value left from an earlier run.
    set(SDKCONFIG "${CMAKE_BINARY_DIR}/sdkconfig.production")
    file(REMOVE "${SDKCONFIG}")
    set(SDKCONFIG_DEFAULTS
        "${ROBOHUB_ESP_PRODUCTION_DIR}/sdkconfig.production"
        "${ROBOHUB_ESP_PRODUCTION_LOCAL}")
    message(WARNING
        "[robohub-esp32] PRODUCTION build: secure boot v2, flash encryption (release mode) and NVS "
        "encryption. The first boot of this image burns eFuses irreversibly; flash it with "
        "`rho flash --production`, which lists every step first.")
endif()

# ESP-IDF's own project(): including it before `project()` is how a project
# becomes an IDF project rather than one beside it.
include(${IDF_PATH}/tools/cmake/project.cmake)
